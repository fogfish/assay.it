---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import DossierIndexPreview from "@/components/widgets/DossierIndexPreview.astro";
import { examples } from "@/collections/dossier-demo.js";
import { ArrowRight } from "@lucide/astro";
---

<div
  class="relative site-container z-20 w-full mx-auto mt-16 px-4 md:mt-18 lg:mt-32 xl:px-0"
>
  <div
    class="relative w-full px-4 flex flex-col items-center justify-between md:flex-row mb-16"
  >
    <!-- Left: Text -->
    <div
      class="relative w-full md:max-w-[560px] md:w-1/2 text-center sm:text-left sm:-mt-8"
    >
      <!-- Badges -->
      <div
        class="flex flex-wrap gap-2 justify-center sm:justify-start mb-6"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Badge variant="primary">Pay per document</Badge>
        <Badge variant="accent">Powered by Anthropic models</Badge>
      </div>

      <!-- Title -->
      <h1 class="mb-4">
        <AnimatedText
          content="Paste the whitepaper. \n Get every claim in it \n — checked."
          delay={0.1}
          duration={0.5}
          stagger={0.08}
          class="text-4xl text-pri leading-tight md:text-4xl lg:text-6xl font-brand"
        />
      </h1>
      <!--           class="text-4xl text-pri leading-tight md:text-4xl xl:text-5xl font-brand" -->

      <!-- Subtitle -->
      <div class="mb-6">
        <AnimatedText
          content="Assay reads the documents your decisions depend on: vendor whitepapers, benchmarks, engineering blog posts, design docs, and verifies every claim the author makes against public sources. \n \n You get a claim-by-claim verdict with citations, before you bet an architecture on someone else's word."
          delay={0.3}
          duration={0.5}
          stagger={0.015}
          class="text-base text-neutral-600 dark:text-neutral-300 leading-relaxed"
        />
      </div>

      <!-- Buttons -->
      <div
        class="flex flex-wrap gap-3 justify-center sm:justify-start"
        data-aos="fade-up-sm"
        data-aos-delay="600"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Button url="https://app.assay.it" type="fill">
          Run Your First Analysis<ArrowRight size={16} />
        </Button>
        <Button url="#example"> See a Real Example</Button>
      </div>
      <p
        class="mt-3 text-xs text-neutral-400 dark:text-neutral-500"
        data-aos="fade-up-sm"
        data-aos-delay="700"
        data-aos-duration="500"
        data-aos-once="true"
      >
        about €2.40 per document, no subscription
      </p>

      <!-- Credibility strip -->
      <p
        class="mt-8 text-xs text-neutral-400 dark:text-neutral-500 leading-relaxed border-t border-dashed border-neutral-200 dark:border-neutral-700 pt-4"
        data-aos="fade-up-xs"
        data-aos-delay="750"
        data-aos-duration="500"
        data-aos-once="true"
      >
        Built by a principal engineer, for engineers who work with technical
        documents. Runs on Anthropic models. Every verdict cites its sources.
      </p>
    </div>

    <!-- Right: Product Preview (dossier overview) -->
    <div
      class="relative justify-end w-full mt-16 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      data-aos="fade-left-sm"
      data-aos-delay="300"
      data-aos-duration="800"
      data-aos-once="true"
    >
      <BrowserFrame url="https://app.assay.it">
        <div class="p-5 md:p-6 h-[500px] md:h-[500px]">
          <DossierIndexPreview dossier={examples.heroPrimeVideo} />
        </div>
      </BrowserFrame>
      <!-- <BrowserFrame url="assay.it" className="w-full">
        <div class="p-5 md:p-6 h-[300px] md:h-[350px] relative">
          <span class="hero-live-dot absolute top-5 right-5 md:top-6 md:right-6 w-2 h-2 rounded-full bg-emerald-500 z-10"></span>
          <DossierIndexPreview dossier={examples.realAnalysis.dossier} compact maxHypotheses={4} />
        </div>
      </BrowserFrame> -->
    </div>
  </div>
</div>

<style>
  /* ─── Live ping dot (toolbar) ─────────────────────── */
  .hero-live-dot::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: currentColor;
    color: rgb(16, 185, 129);
    animation: hero-live-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes hero-live-ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-live-dot::before {
      animation: none !important;
    }
  }
</style>
