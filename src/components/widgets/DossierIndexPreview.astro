---
// Renders the dossier-overview screen from /poc/2026-07-19/assay-dossier-index-v3.html
// inside a <BrowserFrame>. Pass a `dossier` object shaped like the ones in
// src/collections/dossier-demo.js — edit that file's named examples (or add
// a new one) to swap in different content without touching this component.
import {
  examples,
  frictionMeta,
  standingMeta,
} from "@/collections/dossier-demo.js";
import { FileText } from "@lucide/astro";

type HighlightArea = "toolbar" | "abstract" | "glance" | "entries";

interface Props {
  dossier?: (typeof examples)["realAnalysis"]["dossier"];
  compact?: boolean;
  showHypotheses?: boolean;
  maxHypotheses?: number;
  showProblems?: boolean;
  maxProblems?: number;
  highlight?: HighlightArea | HighlightArea[];
  className?: string;
}

const {
  dossier = examples.realAnalysis.dossier,
  compact = false,
  showHypotheses = true,
  maxHypotheses = compact ? 3 : dossier.hypotheses.length,
  showProblems = true,
  maxProblems = compact ? 2 : dossier.problems.length,
  highlight,
  className = "",
} = Astro.props;

const hypotheses = dossier.hypotheses.slice(0, maxHypotheses);
const problems = dossier.problems.slice(0, maxProblems);

const plural = (n: number, singular: string, irregularPlural?: string) =>
  `${n} ${n === 1 ? singular : (irregularPlural ?? `${singular}s`)}`;

// "Elevates" one area of the screen — its own opaque card layer with a
// soft drop shadow, no border — while the rest dims down, so a feature
// blurb can point at a real, in-context part of the product instead of
// an isolated fragment. Padding only ever grows inward (box-sizing:
// border-box keeps the outer box the same width as its siblings) and
// nothing uses negative margins or transforms, so it can never push a
// clipped (overflow-hidden) ancestor (e.g. the entry rows list) into
// horizontal scroll.
const lit = highlight
  ? Array.isArray(highlight)
    ? highlight
    : [highlight]
  : [];
const SPOT_BASE =
  "relative z-20 rounded-lg bg-bg-primary/95 dark:bg-neutral-800/95 shadow-[0_8px_20px_-8px_rgba(15,23,42,0.25)] dark:shadow-[0_8px_20px_-8px_rgba(0,0,0,0.5)]";
const SPOT_EXTRA: Record<HighlightArea, string> = {
  toolbar: "px-3 py-2",
  abstract: "px-3 py-2",
  glance: "px-3 py-2",
  // "entries" already owns pt-2/border-t, so only pad the other sides.
  entries: "px-3 pb-2",
};
const spot = (area: HighlightArea) =>
  lit.includes(area) ? `${SPOT_BASE} ${SPOT_EXTRA[area]}` : "";
const dim = (area: HighlightArea) =>
  lit.length && !lit.includes(area) ? "opacity-35 dark:opacity-25" : "";

// One shared color grammar across both heat-map tracks and both row-chip
// vocabularies — green=holds, amber=contested, brick=fails, gray=unknown.
// Novelty is deliberately not part of this grammar (see dossier-demo.js).
const legend = [
  {
    color: "var(--color-verdict-supported)",
    label: "Holds — supported / solved",
  },
  { color: "var(--color-verdict-context)", label: "Contested" },
  {
    color: "var(--color-verdict-contradicted)",
    label: "Fails — contradicted / open gap",
  },
  { color: "var(--color-verdict-unverifiable)", label: "Unverifiable" },
];
---

<div class={`flex flex-col gap-3 h-full ${className}`}>
  <!-- Toolbar -->
  <div class={`flex items-center justify-between gap-2 flex-shrink-0 ${spot("toolbar")} ${dim("toolbar")}`}>
    <div class="flex items-center gap-2 min-w-0">
      <FileText class="w-3.5 h-3.5 text-primary flex-shrink-0" />
      <span class="text-xs font-brand text-neutral-700 dark:text-neutral-200 truncate">{dossier.title}</span>
    </div>
    {!compact && (
      <div class="flex items-center gap-1.5 flex-shrink-0">
        <span class="text-[9px] text-primary border border-primary/30 dark:border-primary-light/30 rounded px-2 py-1 whitespace-nowrap">Source ↗</span>
        <span class="text-[9px] text-white bg-primary rounded px-2 py-1 whitespace-nowrap">Export one-pager</span>
      </div>
    )}
  </div>

  {!compact && (
    <p class="text-[10px] text-neutral-400 flex-shrink-0">
      {dossier.type} · {dossier.author} · {dossier.source} · Analyzed {dossier.analyzedDate}
      · {plural(dossier.counts.hypotheses, "hypothesis", "hypotheses")} · {plural(dossier.counts.problems, "problem")} · {plural(dossier.counts.entities, "entity", "entities")}
    </p>
  )}

  {!compact && (
    <p
      class={`text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed border-l-2 pl-3 flex-shrink-0 ${spot("abstract")} ${dim("abstract")}`}
      style="border-color: var(--color-hallmark)"
    >
      {dossier.abstract}
    </p>
  )}

  <!-- At a glance heat map -->
  {!compact && (
    <div class={`flex-shrink-0 rounded-lg border border-primary/10 dark:border-neutral-700 px-3 py-2.5 ${spot("glance")} ${dim("glance")}`}>
      <p class="text-[9px] font-semibold uppercase tracking-wider text-neutral-400 mb-2">At a glance</p>

      <div class="flex items-center gap-2.5 mb-2">
        <span class="text-[10.5px] font-medium text-neutral-600 dark:text-neutral-300 w-[76px] flex-shrink-0">
          Hypotheses <span class="text-neutral-400 font-normal">· {dossier.glance.hypotheses.total}</span>
        </span>
        <div class="flex h-2 rounded-full overflow-hidden flex-1">
          {dossier.glance.hypotheses.segments.map((s) => (
            <span
              title={`${standingMeta[s.standing].label} · ${s.count}`}
              style={`width: ${(s.count / dossier.glance.hypotheses.total) * 100}%; background: ${standingMeta[s.standing].color}`}
            />
          ))}
        </div>
        <span class="w-[74px] flex-shrink-0 text-right">
          {dossier.glance.hypotheses.novel > 0 ? (
            <span
              class="text-[10px] font-medium rounded-full px-2 py-0.5 whitespace-nowrap"
              style="color: var(--color-hallmark); border: 1px solid var(--color-hallmark); background: color-mix(in oklab, var(--color-hallmark) 12%, transparent)"
            >
              {dossier.glance.hypotheses.novel} novel ◆
            </span>
          ) : (
            <span class="text-[10px] text-neutral-400">none novel</span>
          )}
        </span>
      </div>

      <div class="flex items-center gap-2.5">
        <span class="text-[10.5px] font-medium text-neutral-600 dark:text-neutral-300 w-[76px] flex-shrink-0">
          Problems <span class="text-neutral-400 font-normal">· {dossier.glance.problems.total}</span>
        </span>
        <div class="flex h-2 rounded-full overflow-hidden flex-1">
          {dossier.glance.problems.segments.map((s) => (
            <span
              title={`${frictionMeta[s.friction].label} · ${s.count}`}
              style={`width: ${(s.count / dossier.glance.problems.total) * 100}%; background: ${frictionMeta[s.friction].color}`}
            />
          ))}
        </div>
        <span class="w-[74px] flex-shrink-0 text-right text-[10px] text-neutral-400 whitespace-nowrap">
          {dossier.glance.problems.openGap > 0 ? `${dossier.glance.problems.openGap} open gap` : "none open"}
        </span>
      </div>

      <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2.5 pt-2 border-t border-dashed border-neutral-200 dark:border-neutral-700">
        {legend.map((l) => (
          <span class="inline-flex items-center gap-1 text-[9.5px] text-neutral-500 dark:text-neutral-400">
            <span class="w-1.5 h-1.5 rounded-sm flex-shrink-0" style={`background: ${l.color}`} />
            {l.label}
          </span>
        ))}
        <span class="inline-flex items-center gap-1 text-[9.5px] text-neutral-500 dark:text-neutral-400">
          <span style="color: var(--color-hallmark)">◆</span> Novel — no prior art
        </span>
      </div>
    </div>
  )}

  <!-- Hypotheses / Problems rows -->
  <div class={`flex-1 min-h-0 overflow-hidden flex flex-col gap-3 border-t border-dashed border-neutral-200 dark:border-neutral-700 pt-2 ${spot("entries")} ${dim("entries")}`}>
    {showHypotheses && (
    <div>
      <div class="flex items-baseline gap-2 mb-1.5">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-neutral-400">Hypotheses</p>
        <span class="text-[9px] text-neutral-400">{dossier.hypotheses.length} extracted</span>
      </div>
      <div class="flex flex-col gap-1.5">
        {hypotheses.map((h) => {
          const meta = standingMeta[h.standing];
          return (
            <div class="flex items-start gap-2 rounded-lg border border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-800/40 px-2.5 py-2">
              <span class="text-[10px] text-neutral-400 w-3.5 flex-shrink-0 text-right pt-0.5">{h.num}</span>
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline gap-1.5 flex-wrap">
                  <span class="text-[11px] font-medium font-brand text-neutral-700 dark:text-neutral-200">{h.title}</span>
                  {h.novel && (
                    <span
                      class="text-[8px] font-medium uppercase tracking-wide rounded-full px-1.5 py-0.5 flex-shrink-0"
                      style="color: var(--color-hallmark); border: 1px solid var(--color-hallmark); background: color-mix(in oklab, var(--color-hallmark) 12%, transparent)"
                    >
                      ◆ novel
                    </span>
                  )}
                  <span class="text-[8px] uppercase tracking-wide text-neutral-400 border border-neutral-200 dark:border-neutral-700 rounded-full px-1.5 py-0.5 flex-shrink-0">{h.facet}</span>
                </div>
                {!compact && <p class="text-[10px] text-neutral-400 leading-snug mt-0.5">{h.claim}</p>}
                {!compact && (
                  <p class="text-[9px] text-neutral-400 mt-1">
                    Prior art <b class="text-neutral-500 dark:text-neutral-300 font-medium">{h.priorArt}</b> · confidence <b class="text-neutral-500 dark:text-neutral-300 font-medium">{h.confidence}</b> · {plural(h.citations, "citation")} · addresses {plural(h.addresses, "problem")}
                  </p>
                )}
              </div>
              <span
                class="text-[9px] font-semibold flex-shrink-0 rounded px-2 py-1 text-center whitespace-nowrap"
                style={`color: ${meta.color}; background: color-mix(in oklab, ${meta.color} 10%, transparent); border: 1px solid color-mix(in oklab, ${meta.color} 45%, transparent)`}
              >
                {meta.label}
              </span>
            </div>
          );
        })}
      </div>
    </div>
    )}

    {showProblems && problems.length > 0 && (
      <div>
        <div class="flex items-baseline gap-2 mb-1.5">
          <p class="text-[10px] font-semibold uppercase tracking-wider text-neutral-400">Problems</p>
          <span class="text-[9px] text-neutral-400">{dossier.problems.length} extracted</span>
        </div>
        <div class="flex flex-col gap-1.5">
          {problems.map((p) => {
            const meta = frictionMeta[p.friction];
            return (
              <div class="flex items-start gap-2 rounded-lg border border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-800/40 px-2.5 py-2">
                <span class="text-[10px] text-neutral-400 w-3.5 flex-shrink-0 text-right pt-0.5">{p.num}</span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline gap-1.5 flex-wrap">
                    <span class="text-[11px] font-medium font-brand text-neutral-700 dark:text-neutral-200">{p.title}</span>
                    <span class="text-[8px] uppercase tracking-wide text-neutral-400 border border-neutral-200 dark:border-neutral-700 rounded-full px-1.5 py-0.5 flex-shrink-0">{p.facet}</span>
                  </div>
                  {!compact && <p class="text-[10px] text-neutral-400 leading-snug mt-0.5">{p.claim}</p>}
                  {!compact && (
                    <p class="text-[9px] text-neutral-400 mt-1">
                      Confidence <b class="text-neutral-500 dark:text-neutral-300 font-medium">{p.confidence}</b> · {plural(p.issues, "issue")} · {p.solutions > 0 ? plural(p.solutions, "solution") : "no solutions found"}
                    </p>
                  )}
                </div>
                <span
                  class="text-[9px] font-semibold flex-shrink-0 rounded px-2 py-1 text-center whitespace-nowrap"
                  style={`color: ${meta.color}; background: color-mix(in oklab, ${meta.color} 10%, transparent); border: 1px solid color-mix(in oklab, ${meta.color} 45%, transparent)`}
                >
                  {meta.label}
                </span>
              </div>
            );
          })}
        </div>
      </div>
    )}
  </div>
</div>
