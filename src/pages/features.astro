---
import { getCollection } from "astro:content";
import { examples } from "@/collections/dossier-demo.js";
import PageHeader from "@/components/elements/PageHeader.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import Button from "@/components/ui/Button.astro";
import DossierEntryPreview from "@/components/widgets/DossierEntryPreview.astro";
import DossierIndexPreview from "@/components/widgets/DossierIndexPreview.astro";
import Layout from "@/layouts/Layout.astro";
import {
	ANALYSIS_BASE,
	analysisPath,
	featuredAnalysis,
} from "@/utils/analysis.js";
import {
	ArrowRight,
	Check,
	FileCheck,
	FileSearch,
	Link2,
	Scale,
	ScanSearch,
	ShieldAlert,
} from "@lucide/astro";

// The published example the closing CTA points at — resolved from the
// analysis collection so no slug is hardcoded here.
const featuredEntry = featuredAnalysis(await getCollection("analysis"));
const featuredExample = featuredEntry
	? analysisPath(featuredEntry.id)
	: ANALYSIS_BASE;

const featureModules = [
	{
		icon: FileSearch,
		title: "Claim extraction, not summarization",
		desc: "Assay reads the full document and isolates every substantive claim the author stated, the vendor's performance numbers, the migration story's savings, the benchmark's methodology. It builds a claim inventory, not a summary.",
		points: [
			"Typically 9 - 10 claims per 10 page document",
			"Works on whitepapers, benchmarks, blog posts, design docs",
			"The claim inventory is the input to downstream validation",
		],
		direction: "left",
		visual: "extract",
		url: "https://app.assay.it",
	},
	{
		icon: ScanSearch,
		title: "An independent validation of each claim",
		desc: "Each claim gets its own deep validation against public documentation, academic papers, articles, blogs and web sources. Not one search across the whole document, but a dedicated verification pass per claim.",
		points: [
			"Each claim is validated independently",
			"Runs on Anthropic models",
			"Typical run time: 9–10 minutes for a 5-page document",
		],
		direction: "right",
		visual: "verify",
		url: "https://app.assay.it",
	},
	{
		icon: FileCheck,
		title: "A decision-ready one-pager",
		desc: "You get a paper: every claim, a verdict, the evidence behind it, and links to every source, so you can check the checker before you cite it in your own work.",
		points: [
			"Claim-by-claim verdict with citations",
			"Exported as Markdown or styled HTML",
			"Provides both one-pager executive summary and detailed analysis",
		],
		direction: "left",
		visual: "deliver",
		url: "https://app.assay.it",
	},
	{
		icon: Scale,
		title: "Four verdicts, not a confidence score",
		desc: "Every claim resolves to one of four states — no vague percentage, no false precision. You know exactly how much weight a claim can bear.",
		points: [
			"Supported — confirmed by prior art or an independent source",
			"Contested — evidence is mixed or context-dependent",
			"Contradicted — current evidence disagrees with the claim",
			"Unverifiable — no independent source exists, and Assay says so instead of guessing",
		],
		direction: "right",
		visual: "verdicts",
		url: "https://app.assay.it",
	},
	{
		icon: Link2,
		title: "Every verdict cites its sources",
		desc: "No verdict without a citation. Documentation pages, benchmark repos, issue threads, postmortems — the evidence trail is part of the deliverable, not an afterthought.",
		points: [
			"Every verdict links the evidence behind it",
			"Disagree with a verdict? Check the same sources Assay did",
			"Treat it as a research assistant you can audit, not an oracle",
		],
		direction: "left",
		visual: "sources",
		url: "https://app.assay.it",
	},
	{
		icon: ShieldAlert,
		title: "Won't oversell what it can't do",
		desc: "A verification tool that oversells itself would be a bad joke. Assay tells you when it doesn't know, and leaves the judgment calls to you.",
		points: [
			"No “absolute certainty” — verdicts are evidence-backed judgments",
			"Unverifiable means unverifiable, not “probably fine”",
			"Won't tell you if the technology fits your context — that's still your call",
		],
		direction: "right",
		visual: "limits",
		url: "https://app.assay.it",
	},
];

// The same claim, followed end to end: appears in the dossier list, gets
// opened, its assumptions get checked, it resolves to a verdict, and that
// verdict cites its sources. "limits" switches back to the dossier index,
// scoped to the Problems section — that's where Unverifiable/Critical gap
// verdicts live in this schema, not on a Hypothesis entry page.
const dossier = examples.features.dossier;
const claim = examples.features.featuredEntry;
---

<Layout
  title="Features — assay.it"
  description="Claim extraction, per-claim verification, verdicts with citations, and the honest limits of what an AI research agent can tell you."
>
  <section class="site-container my-12">
    <PageHeader
      title="From document to verified one-pager"
      description="Claim extraction, per-claim verification. \n A verdict system built to be audited — not trusted blindly."
    />
  </section>

  <!-- Feature Detail Modules -->
  {featureModules.map((mod) => (
    <section class="py-16 md:py-24 site-container">
      <div class={`flex flex-col ${mod.direction === 'right' ? 'md:flex-row-reverse' : 'md:flex-row'} items-center gap-10 md:gap-16`}>
        <!-- Text -->
        <div class="flex-1 min-w-0" data-aos={mod.direction === 'right' ? 'fade-left-sm' : 'fade-right-sm'} data-aos-once="true">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
            <mod.icon class="w-6 h-6 text-primary" />
          </div>
          <h2 class="text-2xl md:text-3xl font-brand mb-4">{mod.title}</h2>
          <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">{mod.desc}</p>
          <ul class="space-y-3">
            {mod.points.map((point) => (
              <li class="flex items-start gap-2">
                <Check class="w-4 h-4 text-primary mt-0.5 flex-shrink-0" />
                <span class="text-sm text-neutral-600 dark:text-neutral-300">{point}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Visual: the same real screen shown on the homepage — full -->
        <!-- BrowserFrame, full detail — with the area this feature is -->
        <!-- about elevated (ring + glow) and the rest dimmed, so nothing -->
        <!-- is cropped out of context. -->
        <div class="flex-1 min-w-0 w-full" data-aos={mod.direction === 'right' ? 'fade-right-sm' : 'fade-left-sm'} data-aos-delay="200" data-aos-once="true">
          <BrowserFrame url={mod.url}>
            <div class="p-5 md:p-6 h-[360px] md:h-[440px]">

              <!-- 1. Extract: the dossier's claim inventory -->
              {mod.visual === "extract" && (
                <DossierEntryPreview entry={examples.realPrimeVideoHypothesis} />
              )}

              <!-- 2. Verify: opened this claim, each assumption checkable on its own -->
              {mod.visual === "verify" && (
                <DossierEntryPreview entry={examples.realPrimeVideoHypothesis} highlight={["banner", "title"]} />
              )}

              <!-- 3. Deliver: the verdict + thesis pairing is the one-pager -->
              {mod.visual === "deliver" && (
                <DossierIndexPreview dossier={examples.heroPrimeVideo} />
              )}

              <!-- 4. Verdicts: the dossier list, where all four standings sit
              side by side in the heat map and the row chips -->
              {mod.visual === "verdicts" && (
                <DossierIndexPreview dossier={dossier} highlight={["glance"]} />
              )}

              <!-- 5. Sources: every citation behind this claim's verdict -->
              {mod.visual === "sources" && (
                <DossierEntryPreview entry={examples.realPrimeVideoHypothesis} highlight="citations" />
              )}

              <!-- 6. Limits: back to the dossier list, scoped to the Problems
              section — Critical gap / Unverified live there, not on a
              Hypothesis entry page -->
              {mod.visual === "limits" && (
                <DossierIndexPreview dossier={dossier} showHypotheses={false} highlight="entries" />
              )}

            </div>
          </BrowserFrame>
        </div>
      </div>
    </section>
  ))}

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

  <!-- CTA -->
  <section class="py-16 md:py-24 site-container" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-brand mb-4">See a real analysis</h2>
      <p class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed">
        Read a real example dossier, then run your own document when you're ready.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button url={featuredExample} type="fill" className="text-lg px-8 py-3">
          See a real analysis <ArrowRight size={18} />
        </Button>
        <Button url="https://app.assay.it" className="text-lg px-8 py-3">
          Analyze a document
        </Button>
      </div>
    </div>
  </section>
</Layout>
