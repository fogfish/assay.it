---
import { verdictMeta } from "@/collections/verdicts.js";
// One shelf unit in the gallery: the analyzed document, its two heat
// bars, and the headline finding it is worth clicking for.
//
// A shelved entry (status: "soon") renders the same card with empty bar
// troughs and a hallmark-gold "Next up" strip instead of a finding, and
// is not a link — there is no page behind it yet.
import HeatBar from "@/components/ui/HeatBar.astro";
import {
	analysisPath,
	formatDate,
	genreSlug,
	isPublished,
} from "@/utils/analysis.js";

interface Props {
	entry: any;
	"data-aos"?: string;
	"data-aos-delay"?: number | string;
}

const {
	entry,
	"data-aos": dataAos,
	"data-aos-delay": dataAosDelay,
} = Astro.props;
const { data } = entry;
const published = isPublished(entry);

const byline = [
	data.source.type,
	data.source.author,
	data.source.publisher,
	published ? `analyzed ${formatDate(data.source.analyzedDate)}` : null,
	data.methodology.sources != null
		? `${data.methodology.sources} sources`
		: null,
]
	.filter(Boolean)
	.join(" · ");

// The headline finding is the standout claim's verdict, restated in one
// line. Falls back to the entry description so a card is never blank.
const headline = data.standout
	? {
			tag: (verdictMeta[data.standout.verdict] ?? verdictMeta.unverifiable)
				.label,
			color: (verdictMeta[data.standout.verdict] ?? verdictMeta.unverifiable)
				.color,
			text: data.description,
		}
	: {
			tag: "Next up",
			color: "var(--color-hallmark)",
			text: data.teaser ?? data.description,
		};

// A shelved card is a <div>, not a dead <a>: there is no page behind it
// yet, so it should not be focusable or followable. Typed loosely because
// the tag — and therefore which attributes are valid — is decided here.
const Wrapper: any = published ? "a" : "div";
const wrapperProps = published ? { href: analysisPath(entry.id) } : {};

const tracks = [
	{ label: "Hypotheses", track: data.glance?.hypotheses },
	{ label: "Problems", track: data.glance?.problems },
];
---

<Wrapper
  {...wrapperProps}
  data-genre={genreSlug(data.genre)}
  data-analysis-card
  class:list={[
    "group block rounded-2xl border border-primary/15 dark:border-neutral-700 bg-bg-secondary dark:bg-neutral-900 px-5 py-5 sm:px-6 sm:py-6 transition-all duration-300",
    published
      ? "hover:border-primary/50 hover:shadow-[0_4px_16px_-6px_rgba(35,34,28,0.18)] hover:-translate-y-0.5"
      : "opacity-90",
  ]}
  data-aos={dataAos}
  data-aos-delay={dataAosDelay}
>
  <!-- Title + genre -->
  <div class="flex items-baseline gap-3 flex-wrap">
    <h2
      class:list={[
        "flex-1 min-w-[240px] font-brand text-xl sm:text-2xl leading-snug text-neutral-800 dark:text-neutral-100 transition-colors",
        published &&
          "group-hover:text-primary dark:group-hover:text-primary-light",
      ]}
    >
      {data.title}
    </h2>
    <span
      class="flex-shrink-0 text-[10px] font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700 bg-bg-primary-light dark:bg-neutral-800 rounded-full px-2.5 py-0.5"
      >{data.genre}</span
    >
  </div>

  <p class="mt-1.5 text-[13px] text-neutral-500 dark:text-neutral-400">
    {byline}
  </p>

  <!-- Heat bars -->
  <div class="mt-4 max-w-[460px] space-y-2">
    {
      tracks.map((t) => (
        <div class="flex items-center gap-3">
          <span class="w-[92px] flex-shrink-0 text-xs text-neutral-500 dark:text-neutral-400">
            {t.label}
            <span class="text-neutral-400"> · {t.track?.total ?? "—"}</span>
          </span>
          <HeatBar track={t.track} height={10} className="flex-1" />
        </div>
      ))
    }
  </div>

  <!-- Headline finding -->
  <div
    class="mt-4 rounded-r-lg px-3.5 py-2.5 text-sm leading-relaxed"
    style={`background: color-mix(in oklab, ${headline.color} 10%, transparent); border-left: 3px solid ${headline.color}`}
  >
    <span
      class="font-bold uppercase tracking-wide text-[11px] mr-1.5"
      style={`color: ${headline.color}`}>{headline.tag}</span
    >
    <span class="text-neutral-700 dark:text-neutral-300">{headline.text}</span>
  </div>

  <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">
    {
      published ? (
        <>
          {data.methodology.claims != null && (
            <>{data.methodology.claims} claims verified · </>
          )}
          <span class="text-primary dark:text-primary-light font-medium">
            Read the analysis &rarr;
          </span>
        </>
      ) : (
        "Publishing soon"
      )
    }
  </p>
</Wrapper>
