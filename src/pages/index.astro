---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Pricing from "@/components/sections/Pricing.astro";
import FAQ from "@/components/sections/FAQ.astro";
import Button from "@/components/ui/Button.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import DossierIndexPreview from "@/components/widgets/DossierIndexPreview.astro";
import DossierEntryPreview from "@/components/widgets/DossierEntryPreview.astro";
import { examples } from "@/collections/dossier-demo.js";
import {
  Search,
  Clock,
  TriangleAlert,
  FileSearch,
  ScanSearch,
  FileCheck,
  CircleQuestionMark,
  Scale,
  UserCheck,
  ShieldCheck,
  Bot,
  Quote,
  Award,
  ArrowRight,
  User,
} from "@lucide/astro";

// FAQ data
const faqItems = [
  {
    question: "What exactly counts as one document analysis?",
    answer:
      "One uploaded document, including claim extraction, per-claim verification, and the exported one-pager and full assessment document. Longer documents show a higher estimate before the run. Nothing is charged without your approval.",
  },
  {
    question: "Can I use it on internal / confidential documents?",
    answer:
      "Yes, if you're comfortable doing so. Access to your document is restricted to you. Your documents are processed within our own isolated AWS infrastructure, and access to the production environment is restricted to the service owner. We do not use your documents to train AI models. That said, no online service can promise zero risk. If your organisation has strict security or compliance requirements (for example, policies that prohibit uploading confidential information to third-party services), you should follow those policies before using the service. If you have specific security or compliance questions, feel free to get in touch.",
  },
  {
    question: "What models does it use?",
    answer:
      "The service uses Anthropic models. Your content is not used to train models.",
  },
  {
    question: "How is this different from ChatGPT / Gemini deep research?",
    answer:
      'Deep research tools answer a question you pose. Assay interrogates a document someone else wrote: it inventories the author\'s claims and checks each one independently. It\'s the difference between "tell me about X" and "is this document about X telling the truth."',
  },
  {
    question: "What if a verdict is wrong?",
    answer:
      "It can be. That's why every verdict links every source it used. Treat the output as a fast, thorough research assistant whose work you can audit in minutes, not an oracle. [PLACEHOLDER: refund policy for failed/garbage runs — have one, state it.]",
  },
  {
    question: "Is there a free way to evaluate it?",
    answer:
      "The full example analysis of Amazon Prime Video above is public — that's real output, not a mockup.",
    // "The full example analysis of Amazon Prime Video above is public — that's real output, not a mockup. Sign up to the service to get first analysis for free.",
  },
];

// Problem cards data
const problems = [
  {
    icon: Search,
    title: "You already suspect it's lying somewhere",
    desc: "Every technology decision starts with reading: the vendor's whitepaper, the “we migrated and cut costs 40%” blog post, the benchmark that somehow always favors its author. You can't take any of it at face value.",
  },
  {
    icon: Clock,
    title: "Finding where takes all day",
    desc: "So you check it claim by claim, tab by tab, hours per document. Or you don't, and hope the claim you skipped isn't the one that fails in production.",
  },
  {
    icon: TriangleAlert,
    title: "AI summaries don't solve this",
    desc: "A summary compresses the document; it doesn't challenge it. If the source is wrong, the summary is wrong faster.",
  },
];

// How it works
const steps = [
  {
    icon: FileSearch,
    step: "01",
    title: "Extract",
    desc: "Assay reads the full document and isolates every substantive claim the author stated or implied. It doesn't summarize. It builds a claim inventory. Typically 9 - 12 claims per document.",
  },
  {
    icon: ScanSearch,
    step: "02",
    title: "Verify",
    desc: "Each claim gets its own research run against public sources: documentation, independent benchmarks, issue trackers, papers, postmortems. Not a single search, an agent per claim!",
  },
  {
    icon: FileCheck,
    step: "03",
    title: "Deliver",
    desc: "You get a paper: every claim, a verdict (Supported / Contradicted / Unverifiable), the evidence, and links to every source, so you can check the checker.",
  },
];

// What Assay won't do
const limits = [
  {
    icon: Scale,
    title: "No “absolute certainty”",
    desc: "Verdicts are evidence-backed judgments, not truth oracles. That's why every verdict links its sources so you can disagree with it.",
  },
  {
    icon: CircleQuestionMark,
    title: "Unverifiable means unverifiable",
    desc: "When no independent source exists, Assay says so instead of guessing. In practice, knowing which claims rest on the author's word alone is half the value.",
  },
  {
    icon: UserCheck,
    title: "It won't read your mind",
    desc: "Assay checks what the document says against what the internet knows. Whether the technology fits your context is still your call. The analysis just makes it an informed one.",
  },
];

// Who it's for
const personas = [
  { icon: FileCheck, label: "RFC & ADR authors" },
  { icon: Scale, label: "Build-vs-buy evaluators" },
  { icon: ShieldCheck, label: "Architects vetting vendors" },
  { icon: UserCheck, label: "Anyone whose name goes on the doc" },
];

// Credibility strip
const credibility = [
  { icon: Award, text: "Built by a principal engineer" },
  { icon: Bot, text: "Runs on Anthropic models" },
  { icon: Quote, text: "Every verdict cites its sources" },
];
---

<Layout
  title="assay.it — Verify every claim before you build on it."
  description="Paste a whitepaper, benchmark, or engineering blog post. Assay extracts every claim the author makes and checks it against public sources. Verdicts, citations, and a decision-ready one-pager in minutes."
  keywords="claim verification, whitepaper fact checking, vendor benchmark verification, technical due diligence, AI research agent, RFC decision document"
>
  <!-- 1. Hero -->
  <HeroSection />

  <!-- 2. Credibility strip -->
  <section
    class="py-12 md:py-16 site-container"
    data-aos="fade-up-xs"
    data-aos-once="true"
    data-aos-delay="650"
  >
    <div
      class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 md:gap-8"
    >
      {
        credibility.map((item) => (
          <div class="flex items-center gap-2 px-4 py-2 border border-dashed border-neutral-300 dark:border-neutral-700 rounded-lg">
            <item.icon class="w-4 h-4 text-primary" />
            <span class="text-sm font-medium text-neutral-600 dark:text-neutral-300">
              {item.text}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3. Problem -->
  <section class="py-16 md:py-24 site-container">
    <SectionHeader
      title="You already know the document is lying to you somewhere. \n Finding <i>where</i> takes all day."
      description=" Every technology decision starts with reading material \n you can't take at face value and can't cite without checking it first."
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
      {
        problems.map((problem, i) => (
          <div
            class="p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700"
            data-aos="fade-up-sm"
            data-aos-delay={i * 100}
            data-aos-once="true"
          >
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4">
              <problem.icon class="w-6 h-6 text-primary" />
            </div>
            <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">
              {problem.title}
            </h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
              {problem.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <div
    class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"
  >
  </div>

  <!-- 4. How It Works -->
  <section class="py-16 md:py-24 site-container">
    <SectionHeader title="From document to verified one-pager in three steps" />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
      {
        steps.map((s, i) => (
          <div
            class="relative h-full p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700"
            data-aos="fade-up-sm"
            data-aos-delay={i * 100}
            data-aos-once="true"
          >
            <span class="absolute top-4 right-5 font-brand text-3xl text-primary/15 dark:text-primary-light/15">
              {s.step}
            </span>
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4">
              <s.icon class="w-6 h-6 text-primary" />
            </div>
            <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">
              {s.title}
            </h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
              {s.desc}
            </p>
          </div>
        ))
      }
    </div>
    <p
      class="text-center text-sm text-neutral-500 dark:text-neutral-400 mt-8 max-w-xl mx-auto"
    >
      Typical run time: 9–10 minutes for a 10-page document. <br /> Long enough to
      get coffee, short enough to run before the meeting.
    </p>
  </section>

  <div
    class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"
  >
  </div>

  <!-- 5. Example -->
  <section id="example" class="py-16 md:py-24 site-container scroll-mt-24">
    <SectionHeader
      title="See a real analysis"
      description="A document analyzed end-to-end. Overview and a single hypothesis, browsable below."
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
      <div data-aos="fade-up-sm" data-aos-once="true">
        <BrowserFrame url="https://app.assay.it">
          <div class="p-5 md:p-6 h-[500px] md:h-[500px]">
            <DossierIndexPreview dossier={examples.heroPrimeVideo} />
          </div>
        </BrowserFrame>
        <p
          class="text-center text-xs text-neutral-400 dark:text-neutral-500 mt-3"
        >
          Analysis overview as "one-pager"
        </p>
      </div>
      <div data-aos="fade-up-sm" data-aos-delay="150" data-aos-once="true">
        <BrowserFrame url="https://app.assay.it">
          <div class="p-5 md:p-6 h-[500px] md:h-[500px]">
            <DossierEntryPreview entry={examples.realPrimeVideoHypothesis} />
          </div>
        </BrowserFrame>
        <p
          class="text-center text-xs text-neutral-400 dark:text-neutral-500 mt-3"
        >
          Inside a hypothesis
        </p>
      </div>
    </div>
    <div class="flex flex-col items-center gap-3 mt-8">
      <p
        class="text-center text-xs text-neutral-400 dark:text-neutral-500 max-w-xl"
      >
        Illustrative example — analyze your own document to generate real
        verdicts.
      </p>
      <div
        class="flex flex-wrap gap-3 justify-center sm:justify-start"
        data-aos="fade-up-sm"
        data-aos-delay="600"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Button url="/sign-up" type="fill">
          Run Your Own Document <ArrowRight size={16} />
        </Button>
        <Button
          url="/assets/examples/amazon-prime-video-short.html"
          target="_blank"
        >
          See Full Real Example
        </Button>
      </div>
    </div>
  </section>

  <div
    class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"
  >
  </div>

  <!-- 7. What Assay won't do -->
  <section class="py-16 md:py-24 site-container">
    <SectionHeader
      title="Honest limits"
      description="Because a verification tool that oversells itself would be a bad joke."
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
      {
        limits.map((limit, i) => (
          <div
            class="p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700"
            data-aos="fade-up-sm"
            data-aos-delay={i * 100}
            data-aos-once="true"
          >
            <div class="w-12 h-12 rounded-xl bg-accent/15 flex items-center justify-center mb-4">
              <limit.icon class="w-6 h-6 text-accent" />
            </div>
            <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">
              {limit.title}
            </h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
              {limit.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <div
    class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"
  >
  </div>

  <!-- 8. Who it's for -->
  <section
    class="py-16 md:py-24 site-container"
    data-aos="fade-up-xs"
    data-aos-once="true"
  >
    <SectionHeader
      title="Who it's for"
      description="Staff and principal engineers reading and writing RFCs, ADRs, and build-vs-buy recommendations. Architects evaluating vendors. Anyone whose name goes on a decision document that someone else will read in two years and judge."
    />
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8">
      {
        personas.map((p, i) => (
          <div
            class="flex flex-col items-center p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 text-center hover:shadow-md hover:-translate-y-1 transition-all duration-300"
            data-aos="fade-up-sm"
            data-aos-delay={i * 100}
            data-aos-once="true"
          >
            <p.icon class="w-6 h-6 text-primary mb-2" />
            <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-100">
              {p.label}
            </span>
          </div>
        ))
      }
    </div>
    <p
      class="text-center text-sm text-neutral-500 dark:text-neutral-400 mt-8 max-w-xl mx-auto"
    >
      If your job is deciding, and deciding means reading things you don't fully
      trust, Assay is for you.
    </p>
  </section>

  <div
    class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"
  >
  </div>

  <!-- 9. Pricing -->
  <Pricing
    title="Pay per document"
    description="See the cost before you run it. No subscription. No expiring credits."
  />

  <div
    class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"
  >
  </div>

  <!-- 10. Founder note -->
  <section
    class="py-16 md:py-24 site-container"
    data-aos="fade-up-xs"
    data-aos-once="true"
  >
    <SectionHeader title="A note from the founder" />
    <div
      class="max-w-2xl mx-auto p-8 md:p-10 rounded-2xl border border-primary/10 dark:border-neutral-700 bg-bg-secondary dark:bg-bg-secondary-dark"
    >
      <div class="flex items-center gap-3 mb-6">
        <span
          class="flex items-center justify-center w-11 h-11 rounded-full bg-primary/10 flex-shrink-0"
        >
          <img
            src="/assets/founder.jpg"
            alt="Dmitry Kolesnikov"
            class="w-10 h-10 rounded-full object-cover"
          />
          <!-- <User class="w-5 h-5 text-primary" /> -->
        </span>
        <div>
          <h2 class="text-xl font-brand text-neutral-800 dark:text-neutral-100">
            Why I built this
          </h2>
          <p class="text-xs text-neutral-400 dark:text-neutral-500">
            A note from the founder
          </p>
        </div>
      </div>

      <div
        class="space-y-4 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed"
      >
        <p>
          I'm a principal engineer at a large e-commerce company. A meaningful
          part of my job is writing decision documents and every one of them
          starts with reading material I can't take at face value.
        </p>
        <p>
          I used to spend half of a day fact-checking a single vendor whitepaper
          before I'd cite it in my work. So I built a pipeline that does the
          tedious part: pull out every claim, research each one, show me the
          evidence. I've used it for my own decisions for over a year. Assay is
          that pipeline, cleaned up so you can use it too.
        </p>
        <p>
          It's a small product built by one person. It charges from the first
          document because each analysis runs frontier models hard but you'll
          always see a full example analysis and the exact price before you
          commit a cent. If it saves you one bad architecture bet, it's paid for
          itself for years.
        </p>
        <p class="text-neutral-500 dark:text-neutral-400">
          — <a
            class="text-primary hover:text-primary/80 dark:hover:text-primary/80"
            href="https://www.linkedin.com/in/dmkolesnikov">Dmitry</a
          >
        </p>
      </div>
    </div>
  </section>

  <div
    class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"
  >
  </div>

  <!-- 11. FAQ -->
  <FAQ title="Frequently asked questions" items={faqItems} />

  <!-- 12. Final CTA -->
  <section
    class="py-12 md:py-20 site-container rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10"
    data-aos="fade-up-xs"
    data-aos-once="true"
  >
    <div class="max-w-2xl mx-auto text-center">
      <h2
        class="text-3xl md:text-4xl font-brand mb-4"
        data-aos="fade-up-xs"
        data-aos-once="true"
        data-aos-delay="200"
      >
        The document is 40 pages. <br /> The claims that matter fit on one.
      </h2>
      <p
        class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed"
        data-aos="fade-up-xs"
        data-aos-once="true"
        data-aos-delay="300"
      >
        Run the whitepaper through Assay before your next decision meeting.
      </p>
      <div
        class="flex flex-wrap justify-center gap-3"
        data-aos="fade-up-xs"
        data-aos-once="true"
        data-aos-delay="400"
      >
        <Button url="/sign-up" type="fill" className="text-lg px-8 py-3">
          Analyze a document <ArrowRight size={18} />
        </Button>
      </div>
      <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-4">
        See the price before you run it.
      </p>
    </div>
  </section>
</Layout>
