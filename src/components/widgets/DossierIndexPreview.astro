---
// Renders the dossier-overview screen from /poc/assay-dossier-index-mockup.html
// inside a <BrowserFrame>. Content comes from src/collections/dossier-demo.js —
// edit that file to swap in a real compiled example.
import { dossier, verdictMeta } from "@/collections/dossier-demo.js";
import { FileText } from "@lucide/astro";

interface Props {
  compact?: boolean;
  maxEntries?: number;
  className?: string;
}

const { compact = false, maxEntries = compact ? 3 : dossier.entries.length, className = "" } = Astro.props;

const entries = dossier.entries.slice(0, maxEntries);
const total = dossier.breakdown.reduce((sum, b) => sum + b.count, 0);
---

<div class={`flex flex-col gap-3 h-full ${className}`}>
  <!-- Toolbar -->
  <div class="flex items-center justify-between flex-shrink-0">
    <div class="flex items-center gap-2 min-w-0">
      <FileText class="w-3.5 h-3.5 text-primary flex-shrink-0" />
      <span class="text-xs font-semibold text-neutral-700 dark:text-neutral-200 truncate">{dossier.title}</span>
    </div>
    <span class="text-[10px] uppercase tracking-wider text-neutral-400 flex-shrink-0">{dossier.entryCount} entries</span>
  </div>

  {!compact && (
    <p class="text-[10px] text-neutral-400 flex-shrink-0">
      {dossier.type} · {dossier.author} · {dossier.source} · Analyzed {dossier.analyzedDate}
    </p>
  )}

  {!compact && (
    <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed border-l-2 pl-3 flex-shrink-0" style="border-color: var(--color-hallmark)">
      {dossier.synthesis}
    </p>
  )}

  {!compact && (
    <div class="flex-shrink-0">
      <div class="flex h-2.5 rounded-full overflow-hidden">
        {dossier.breakdown.map((b) => (
          <span style={`width: ${(b.count / total) * 100}%; background: ${verdictMeta[b.verdict].color}`} />
        ))}
      </div>
      <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2">
        {dossier.breakdown.map((b) => (
          <span class="inline-flex items-center gap-1 text-[10px] text-neutral-500 dark:text-neutral-400">
            <span class="w-1.5 h-1.5 rounded-sm flex-shrink-0" style={`background: ${verdictMeta[b.verdict].color}`} />
            {verdictMeta[b.verdict].label} · {b.count}
          </span>
        ))}
      </div>
    </div>
  )}

  <!-- Entry rows -->
  <div class="flex-1 min-h-0 overflow-y-auto flex flex-col gap-1.5 border-t border-dashed border-neutral-200 dark:border-neutral-700 pt-2">
    {entries.map((entry) => {
      const meta = verdictMeta[entry.verdict];
      return (
        <div class="flex items-center gap-2 rounded-lg border border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-800/40 px-2.5 py-2">
          <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background: ${meta.color}`} />
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-1.5">
              <span class="text-[11px] font-medium text-neutral-700 dark:text-neutral-200 truncate">{entry.title}</span>
              {!compact && <span class="text-[9px] text-neutral-400 flex-shrink-0">{entry.type}</span>}
            </div>
            {!compact && <p class="text-[10px] text-neutral-400 truncate">{entry.thesis}</p>}
          </div>
          <span class="text-[9px] font-medium flex-shrink-0" style={`color: ${meta.color}`}>{meta.label}</span>
        </div>
      );
    })}
  </div>
</div>
