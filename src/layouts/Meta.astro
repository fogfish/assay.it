---
import StructuredData from "@/components/widgets/StructuredData.astro";
import { siteConfig } from "@/config/site.js";
export interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	url?: string;
	ogImage?: string;
	ogType?: "website" | "article";
	twitterHandle?: string;
}

const {
	title,
	description,
	keywords = "",
	url = siteConfig.url, //
	ogImage = "/og.jpg",
	ogType = "website",
	twitterHandle = siteConfig.social.twitterName || "",
} = Astro.props;

// Crawlers resolve neither relative og:image paths nor relative canonicals,
// so both are made absolute against the configured site URL.
const canonicalUrl = new URL(url, siteConfig.url).href;
const ogImageUrl = new URL(ogImage, siteConfig.url).href;

// Sitewide structured data: brand identity + site-level metadata.
const sameAs = Object.values(siteConfig.social).filter(
	(v) => typeof v === "string" && v.startsWith("http"),
);

const orgId = `${siteConfig.url}#organization`;

const siteSchema = [
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		"@id": orgId,
		name: siteConfig.title,
		url: siteConfig.url,
		logo: new URL("/favicon.png", siteConfig.url).href,
		description: siteConfig.meta.description,
		...(sameAs.length ? { sameAs } : {}),
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"@id": `${siteConfig.url}#website`,
		name: siteConfig.title,
		url: siteConfig.url,
		description: siteConfig.meta.description,
		publisher: { "@id": orgId },
	},
];
---

<!-- Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={siteConfig.author} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph Tags -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={siteConfig.title} />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:site" content={twitterHandle} />
<meta name="twitter:creator" content={twitterHandle} />

<!-- Structured Data (JSON-LD) -->
<StructuredData data={siteSchema} />